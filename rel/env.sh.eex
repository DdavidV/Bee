#!/bin/sh
# Bee is a local app: no Erlang distribution, which would listen on all
# interfaces and start epmd (a daemon outliving Bee). Set
# RELEASE_DISTRIBUTION=sname to turn it on, e.g. for `bin/bee remote`.
export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-none}"

# Desktop mode (Bee.Mode): stdin carries the shell's frames; without
# -noinput the VM's terminal reader would take it too.
if [ "$BEE_MODE" = "desktop" ]; then
  export ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS} -noinput"
fi
