{
  "$schema": "../schemas/manifest.schema.json",
  "name": "bee",
  "description": "Bee's own commands, default keybindings and menus. Plugins contribute in the same format. Command ids follow VS Code. Close Editor has no default key: browsers don't let pages intercept Ctrl+W.",
  "contributes": {
    "commands": [
      {
        "command": "workbench.action.showCommands",
        "title": "Show All Commands",
        "runtime": "server"
      },
      {
        "command": "workbench.action.files.openFolder",
        "category": "File",
        "title": "Open Folder…",
        "runtime": "server"
      },
      {
        "command": "workbench.action.files.openFolderInNewWindow",
        "category": "File",
        "title": "Open Folder in New Window…",
        "runtime": "server"
      },
      {
        "command": "bee.openFolder",
        "category": "File",
        "title": "Open Folder (path)",
        "runtime": "server"
      },
      {
        "command": "workbench.action.files.save",
        "category": "File",
        "title": "Save",
        "runtime": "client",
        "enablement": "activeEditor"
      },
      {
        "command": "undo",
        "category": "Edit",
        "title": "Undo",
        "icon": "arrow-uturn-left",
        "runtime": "client",
        "enablement": "canUndo"
      },
      {
        "command": "redo",
        "category": "Edit",
        "title": "Redo",
        "icon": "arrow-uturn-right",
        "runtime": "client",
        "enablement": "canRedo"
      },
      {
        "command": "workbench.action.closeActiveEditor",
        "category": "View",
        "title": "Close Editor",
        "runtime": "server",
        "enablement": "activeEditor"
      },
      {
        "command": "workbench.action.toggleSidebarVisibility",
        "category": "View",
        "title": "Toggle Primary Side Bar Visibility",
        "runtime": "server",
        "toggled": "sideBarVisible"
      },
      {
        "command": "workbench.view.explorer",
        "category": "View",
        "title": "Show Explorer",
        "runtime": "server",
        "toggled": "activeViewlet == 'workbench.view.explorer'"
      },
      {
        "command": "workbench.view.search",
        "category": "View",
        "title": "Show Search",
        "runtime": "server",
        "toggled": "activeViewlet == 'workbench.view.search'"
      },
      {
        "command": "workbench.action.findInFiles",
        "category": "Search",
        "title": "Find in Files",
        "runtime": "server"
      },
      {
        "command": "workbench.action.replaceInFiles",
        "category": "Search",
        "title": "Replace in Files",
        "runtime": "server"
      },
      {
        "command": "search.action.refreshSearchResults",
        "category": "Search",
        "title": "Refresh",
        "icon": "arrow-path",
        "runtime": "server",
        "enablement": "searchHasQuery"
      },
      {
        "command": "search.action.clearSearchResults",
        "category": "Search",
        "title": "Clear Search Results",
        "icon": "x-mark",
        "runtime": "server",
        "enablement": "searchHasQuery"
      },
      {
        "command": "search.action.collapseSearchResults",
        "category": "Search",
        "title": "Collapse All",
        "icon": "chevron-double-up",
        "runtime": "server",
        "enablement": "hasSearchResult"
      },
      {
        "command": "toggleSearchCaseSensitive",
        "category": "Search",
        "title": "Toggle Match Case",
        "runtime": "server",
        "toggled": "searchCaseSensitive"
      },
      {
        "command": "toggleSearchWholeWord",
        "category": "Search",
        "title": "Toggle Match Whole Word",
        "runtime": "server",
        "toggled": "searchWholeWord"
      },
      {
        "command": "toggleSearchRegex",
        "category": "Search",
        "title": "Toggle Use Regular Expression",
        "runtime": "server",
        "toggled": "searchRegex"
      },
      {
        "command": "workbench.view.extensions",
        "category": "View",
        "title": "Show Plugins",
        "runtime": "server",
        "toggled": "activeViewlet == 'workbench.view.extensions'"
      },
      {
        "command": "workbench.action.togglePanel",
        "category": "View",
        "title": "Toggle Panel Visibility",
        "runtime": "server",
        "toggled": "panelVisible"
      },
      {
        "command": "workbench.action.terminal.new",
        "category": "Terminal",
        "title": "Create New Terminal",
        "runtime": "server"
      },
      {
        "command": "workbench.action.terminal.kill",
        "category": "Terminal",
        "title": "Kill the Active Terminal Instance",
        "runtime": "server",
        "enablement": "terminalCount > 0"
      },
      {
        "command": "workbench.action.openSettingsJson",
        "category": "Preferences",
        "title": "Open User Settings (JSON)",
        "runtime": "server"
      },
      {
        "command": "workbench.action.selectIconTheme",
        "category": "Preferences",
        "title": "File Icon Theme",
        "runtime": "server"
      },
      {
        "command": "workbench.action.setIconTheme",
        "category": "Preferences",
        "title": "Set File Icon Theme",
        "runtime": "server"
      },
      {
        "command": "workbench.action.openWorkspaceSettingsFile",
        "category": "Preferences",
        "title": "Open Workspace Settings (JSON)",
        "runtime": "server"
      },
      {
        "command": "workbench.action.openGlobalKeybindingsFile",
        "category": "Preferences",
        "title": "Open Keyboard Shortcuts (JSON)",
        "runtime": "server"
      },
      {
        "command": "bee.plugins.reload",
        "category": "Developer",
        "title": "Reload Plugins",
        "icon": "arrow-path",
        "runtime": "server"
      },
      {
        "command": "explorer.newFile",
        "category": "File",
        "title": "New File…",
        "icon": "document-plus",
        "runtime": "server"
      },
      {
        "command": "explorer.newFolder",
        "category": "File",
        "title": "New Folder…",
        "icon": "folder-plus",
        "runtime": "server"
      },
      {
        "command": "filesExplorer.cut",
        "category": "File",
        "title": "Cut",
        "runtime": "server"
      },
      {
        "command": "filesExplorer.copy",
        "category": "File",
        "title": "Copy",
        "runtime": "server"
      },
      {
        "command": "filesExplorer.paste",
        "category": "File",
        "title": "Paste",
        "runtime": "server",
        "enablement": "explorerCanPaste"
      },
      {
        "command": "renameFile",
        "category": "File",
        "title": "Rename…",
        "runtime": "server"
      },
      {
        "command": "deleteFile",
        "category": "File",
        "title": "Delete",
        "runtime": "server"
      },
      {
        "command": "deleteFile.confirmed",
        "category": "File",
        "title": "Delete (confirmed)",
        "runtime": "server"
      },
      {
        "command": "workbench.extensions.action.installVSIX",
        "category": "Plugins",
        "title": "Install from VSIX…",
        "icon": "arrow-down-tray",
        "runtime": "client"
      },
      {
        "command": "bee.plugins.uninstall",
        "category": "Plugins",
        "title": "Uninstall",
        "icon": "trash",
        "runtime": "server"
      },
      {
        "command": "bee.plugins.uninstallConfirmed",
        "category": "Plugins",
        "title": "Uninstall (confirmed)",
        "runtime": "server"
      },
      {
        "command": "bee.plugins.enable",
        "category": "Plugins",
        "title": "Enable",
        "icon": "play",
        "runtime": "server"
      },
      {
        "command": "bee.plugins.disable",
        "category": "Plugins",
        "title": "Disable",
        "icon": "no-symbol",
        "runtime": "server"
      }
    ],

    "keybindings": [
      {"key": "f1", "command": "workbench.action.showCommands"},
      {"key": "ctrl+shift+p", "mac": "cmd+shift+p", "command": "workbench.action.showCommands"},
      {"key": "ctrl+s", "mac": "cmd+s", "command": "workbench.action.files.save"},
      {"key": "ctrl+k ctrl+o", "mac": "cmd+k cmd+o", "command": "workbench.action.files.openFolder"},
      {"key": "ctrl+z", "mac": "cmd+z", "command": "undo", "when": "editorTextFocus"},
      {"key": "ctrl+shift+z", "mac": "cmd+shift+z", "command": "redo", "when": "editorTextFocus"},
      {"key": "ctrl+b", "mac": "cmd+b", "command": "workbench.action.toggleSidebarVisibility"},
      {"key": "ctrl+j", "mac": "cmd+j", "command": "workbench.action.togglePanel"},
      {"key": "ctrl+shift+e", "mac": "cmd+shift+e", "command": "workbench.view.explorer"},
      {"key": "ctrl+shift+x", "mac": "cmd+shift+x", "command": "workbench.view.extensions"},
      {"key": "ctrl+shift+f", "mac": "cmd+shift+f", "command": "workbench.action.findInFiles"},
      {"key": "ctrl+shift+h", "mac": "cmd+shift+h", "command": "workbench.action.replaceInFiles"},
      {"key": "alt+c", "mac": "cmd+alt+c", "command": "toggleSearchCaseSensitive", "when": "searchViewletFocus"},
      {"key": "alt+w", "mac": "cmd+alt+w", "command": "toggleSearchWholeWord", "when": "searchViewletFocus"},
      {"key": "alt+r", "mac": "cmd+alt+r", "command": "toggleSearchRegex", "when": "searchViewletFocus"},
      {"key": "ctrl+,", "mac": "cmd+,", "command": "workbench.action.openSettingsJson"},
      {"key": "ctrl+k ctrl+s", "mac": "cmd+k cmd+s", "command": "workbench.action.openGlobalKeybindingsFile"}
    ],

    "viewsContainers": {
      "activitybar": [
        {"id": "explorer", "title": "Explorer", "icon": "document-duplicate"},
        {"id": "search", "title": "Search", "icon": "magnifying-glass"},
        {"id": "extensions", "title": "Plugins", "icon": "puzzle-piece"}
      ]
    },

    "views": {
      "explorer": [{"id": "workbench.explorer.fileView", "name": "Folders"}],
      "search": [{"id": "workbench.view.search", "name": "Search"}],
      "extensions": [{"id": "workbench.extensions.installed", "name": "Installed"}]
    },

    "menubar": [
      {"id": "file", "label": "File"},
      {"id": "edit", "label": "Edit"},
      {"id": "view", "label": "View"},
      {"id": "terminal", "label": "Terminal"}
    ],

    "menus": {
      "menubar/file": [
        {"command": "workbench.action.files.openFolder", "group": "0_open@1"},
        {"command": "workbench.action.files.openFolderInNewWindow", "group": "0_open@2"},
        {"command": "workbench.action.files.save", "group": "1_save@1"},
        {"command": "workbench.action.closeActiveEditor", "group": "1_save@2"},
        {"command": "workbench.action.openSettingsJson", "group": "2_preferences@1"},
        {"command": "workbench.action.openWorkspaceSettingsFile", "group": "2_preferences@2"},
        {"command": "workbench.action.openGlobalKeybindingsFile", "group": "2_preferences@3"},
        {"command": "workbench.action.selectIconTheme", "group": "2_preferences@4"}
      ],
      "menubar/edit": [
        {"command": "undo", "group": "1_do@1"},
        {"command": "redo", "group": "1_do@2"},
        {"command": "workbench.action.findInFiles", "group": "2_find@1"},
        {"command": "workbench.action.replaceInFiles", "group": "2_find@2"}
      ],
      "view/title": [
        {"command": "search.action.refreshSearchResults", "group": "navigation@1", "when": "view == workbench.view.search"},
        {"command": "search.action.clearSearchResults", "group": "navigation@2", "when": "view == workbench.view.search"},
        {"command": "search.action.collapseSearchResults", "group": "navigation@3", "when": "view == workbench.view.search"},
        {"command": "explorer.newFile", "group": "navigation@1", "when": "view == workbench.explorer.fileView"},
        {"command": "explorer.newFolder", "group": "navigation@2", "when": "view == workbench.explorer.fileView"},
        {"command": "workbench.extensions.action.installVSIX", "group": "navigation@1", "when": "view == workbench.extensions.installed"},
        {"command": "bee.plugins.reload", "group": "navigation@2", "when": "view == workbench.extensions.installed"}
      ],
      "view/item/context": [
        {"command": "bee.plugins.disable", "group": "inline@1", "when": "view == workbench.extensions.installed && viewItem =~ /^plugin\\.enabled\\./"},
        {"command": "bee.plugins.enable", "group": "inline@1", "when": "view == workbench.extensions.installed && viewItem =~ /^plugin\\.disabled\\./"},
        {"command": "bee.plugins.uninstall", "group": "inline@2", "when": "view == workbench.extensions.installed && viewItem =~ /\\.user$/"}
      ],
      "explorer/context": [
        {"command": "explorer.newFile", "group": "navigation@1", "when": "explorerResourceIsFolder"},
        {"command": "explorer.newFolder", "group": "navigation@2", "when": "explorerResourceIsFolder"},
        {"command": "filesExplorer.cut", "group": "5_cutcopypaste@1", "when": "!explorerResourceIsRoot"},
        {"command": "filesExplorer.copy", "group": "5_cutcopypaste@2", "when": "!explorerResourceIsRoot"},
        {"command": "filesExplorer.paste", "group": "5_cutcopypaste@3"},
        {"command": "renameFile", "group": "7_modification@1", "when": "!explorerResourceIsRoot"},
        {"command": "deleteFile", "group": "7_modification@2", "when": "!explorerResourceIsRoot"}
      ],
      "commandPalette": [
        {"command": "filesExplorer.cut", "when": "false"},
        {"command": "filesExplorer.copy", "when": "false"},
        {"command": "filesExplorer.paste", "when": "false"},
        {"command": "renameFile", "when": "false"},
        {"command": "deleteFile", "when": "false"},
        {"command": "deleteFile.confirmed", "when": "false"},
        {"command": "bee.plugins.enable", "when": "false"},
        {"command": "bee.openFolder", "when": "false"},
        {"command": "bee.plugins.uninstall", "when": "false"},
        {"command": "bee.plugins.uninstallConfirmed", "when": "false"},
        {"command": "workbench.action.setIconTheme", "when": "false"},
        {"command": "bee.plugins.disable", "when": "false"}
      ],
      "editor/title": [
        {"command": "undo", "group": "navigation@1", "when": "activeEditor"},
        {"command": "redo", "group": "navigation@2", "when": "activeEditor"}
      ],
      "menubar/view": [
        {"command": "workbench.action.showCommands", "group": "1_commands@1"},
        {"command": "workbench.view.explorer", "group": "2_views@1"},
        {"command": "workbench.view.search", "group": "2_views@2"},
        {"command": "workbench.view.extensions", "group": "2_views@3"},
        {"command": "workbench.action.toggleSidebarVisibility", "group": "3_layout@1"},
        {"command": "workbench.action.togglePanel", "group": "3_layout@2"}
      ],
      "menubar/terminal": [
        {"command": "workbench.action.terminal.new", "group": "1_terminal@1"},
        {"command": "workbench.action.terminal.kill", "group": "1_terminal@2"}
      ]
    }
  }
}
