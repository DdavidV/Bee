{
  "$schema": "../schemas/manifest.schema.json",
  "name": "bee",
  "description": "Bee's own commands, default keybindings and menus. Plugins contribute in the same format. Command ids follow VS Code. Close Editor has no default key: browsers don't let pages intercept Ctrl+W.",
  "contributes": {
    "commands": [
      {
        "command": "workbench.action.showCommands",
        "title": "Show All Commands",
        "runtime": "server"
      },
      {
        "command": "workbench.action.quickOpen",
        "title": "Go to File...",
        "runtime": "server"
      },
      {
        "command": "workbench.action.quickOpenPrefix",
        "title": "Quick Open (mode)",
        "runtime": "server"
      },
      {
        "command": "workbench.action.files.openFolder",
        "category": "File",
        "title": "Open Folder…",
        "runtime": "server"
      },
      {
        "command": "workbench.action.files.openFolderInNewWindow",
        "category": "File",
        "title": "Open Folder in New Window…",
        "runtime": "server"
      },
      {
        "command": "bee.openFolder",
        "category": "File",
        "title": "Open Folder (path)",
        "runtime": "server"
      },
      {
        "command": "bee.openFile",
        "category": "File",
        "title": "Open File (path)",
        "runtime": "server"
      },
      {
        "command": "workbench.action.files.save",
        "category": "File",
        "title": "Save",
        "runtime": "client",
        "enablement": "resourceScheme == file"
      },
      {
        "command": "editor.action.clipboardCutAction",
        "category": "Edit",
        "title": "Cut",
        "runtime": "client",
        "enablement": "resourceScheme == file"
      },
      {
        "command": "editor.action.clipboardCopyAction",
        "category": "Edit",
        "title": "Copy",
        "runtime": "client",
        "enablement": "resourceScheme == file"
      },
      {
        "command": "editor.action.clipboardPasteAction",
        "category": "Edit",
        "title": "Paste",
        "runtime": "client",
        "enablement": "resourceScheme == file"
      },
      {
        "command": "editor.action.triggerSuggest",
        "title": "Trigger Suggest",
        "runtime": "client",
        "enablement": "resourceScheme == file"
      },
      {
        "command": "editor.action.showHover",
        "title": "Show Hover",
        "runtime": "client",
        "enablement": "editorHasHoverProvider"
      },
      {
        "command": "editor.action.revealDefinition",
        "title": "Go to Definition",
        "runtime": "client",
        "enablement": "editorHasDefinitionProvider"
      },
      {
        "command": "editor.action.revealDeclaration",
        "title": "Go to Declaration",
        "runtime": "client",
        "enablement": "editorHasDeclarationProvider"
      },
      {
        "command": "editor.action.goToTypeDefinition",
        "title": "Go to Type Definition",
        "runtime": "client",
        "enablement": "editorHasTypeDefinitionProvider"
      },
      {
        "command": "editor.action.goToImplementation",
        "title": "Go to Implementations",
        "runtime": "client",
        "enablement": "editorHasImplementationProvider"
      },
      {
        "command": "undo",
        "category": "Edit",
        "title": "Undo",
        "icon": "arrow-uturn-left",
        "runtime": "client",
        "enablement": "canUndo"
      },
      {
        "command": "redo",
        "category": "Edit",
        "title": "Redo",
        "icon": "arrow-uturn-right",
        "runtime": "client",
        "enablement": "canRedo"
      },
      {
        "command": "workbench.action.closeActiveEditor",
        "category": "View",
        "title": "Close Editor",
        "runtime": "server",
        "enablement": "activeEditor"
      },
      {
        "command": "workbench.action.closeEditor",
        "category": "View",
        "title": "Close",
        "runtime": "server",
        "enablement": "activeEditor"
      },
      {
        "command": "workbench.action.closeOtherEditors",
        "category": "View",
        "title": "Close Others",
        "runtime": "server",
        "enablement": "activeEditor"
      },
      {
        "command": "workbench.action.closeAllEditors",
        "category": "View",
        "title": "Close All",
        "runtime": "server",
        "enablement": "activeEditor"
      },
      {
        "command": "workbench.action.closeEditors.confirmed",
        "category": "View",
        "title": "Close Editors (confirmed)",
        "runtime": "server"
      },
      {
        "command": "copyFilePath",
        "category": "File",
        "title": "Copy Path",
        "runtime": "client",
        "enablement": "resourceScheme == file"
      },
      {
        "command": "workbench.action.toggleSidebarVisibility",
        "category": "View",
        "title": "Toggle Primary Side Bar Visibility",
        "runtime": "server",
        "toggled": "sideBarVisible"
      },
      {
        "command": "workbench.view.explorer",
        "category": "View",
        "title": "Show Explorer",
        "runtime": "server",
        "toggled": "activeViewlet == 'workbench.view.explorer'"
      },
      {
        "command": "workbench.view.search",
        "category": "View",
        "title": "Show Search",
        "runtime": "server",
        "toggled": "activeViewlet == 'workbench.view.search'"
      },
      {
        "command": "workbench.action.findInFiles",
        "category": "Search",
        "title": "Find in Files",
        "runtime": "server"
      },
      {
        "command": "workbench.action.replaceInFiles",
        "category": "Search",
        "title": "Replace in Files",
        "runtime": "server"
      },
      {
        "command": "search.action.refreshSearchResults",
        "category": "Search",
        "title": "Refresh",
        "icon": "arrow-path",
        "runtime": "server",
        "enablement": "searchHasQuery"
      },
      {
        "command": "search.action.clearSearchResults",
        "category": "Search",
        "title": "Clear Search Results",
        "icon": "x-mark",
        "runtime": "server",
        "enablement": "searchHasQuery"
      },
      {
        "command": "search.action.collapseSearchResults",
        "category": "Search",
        "title": "Collapse All",
        "icon": "chevron-double-up",
        "runtime": "server",
        "enablement": "hasSearchResult"
      },
      {
        "command": "toggleSearchCaseSensitive",
        "category": "Search",
        "title": "Toggle Match Case",
        "runtime": "server",
        "toggled": "searchCaseSensitive"
      },
      {
        "command": "toggleSearchWholeWord",
        "category": "Search",
        "title": "Toggle Match Whole Word",
        "runtime": "server",
        "toggled": "searchWholeWord"
      },
      {
        "command": "toggleSearchRegex",
        "category": "Search",
        "title": "Toggle Use Regular Expression",
        "runtime": "server",
        "toggled": "searchRegex"
      },
      {
        "command": "workbench.view.extensions",
        "category": "View",
        "title": "Show Plugins",
        "runtime": "server",
        "toggled": "activeViewlet == 'workbench.view.extensions'"
      },
      {
        "command": "workbench.action.togglePanel",
        "category": "View",
        "title": "Toggle Panel Visibility",
        "runtime": "server",
        "toggled": "panelVisible"
      },
      {
        "command": "workbench.action.closePanel",
        "category": "View",
        "title": "Hide Panel",
        "icon": "x-mark",
        "runtime": "server",
        "enablement": "panelVisible"
      },
      {
        "command": "workbench.action.toggleMaximizedPanel",
        "category": "View",
        "title": "Maximize Panel Size",
        "icon": "chevron-up",
        "runtime": "server",
        "toggled": "panelMaximized"
      },
      {
        "command": "workbench.action.showPanel",
        "category": "View",
        "title": "Show Panel Section",
        "runtime": "server"
      },
      {
        "command": "workbench.action.terminal.new",
        "category": "Terminal",
        "title": "Create New Terminal",
        "icon": "plus",
        "runtime": "server"
      },
      {
        "command": "workbench.action.output.toggleOutput",
        "category": "View",
        "title": "Show Output",
        "runtime": "server"
      },
      {
        "command": "workbench.output.action.clearOutput",
        "category": "View",
        "title": "Clear Output",
        "icon": "trash",
        "runtime": "server"
      },
      {
        "command": "bee.console.open",
        "category": "Developer",
        "title": "Open Bee Console",
        "runtime": "server"
      },
      {
        "command": "bee.console.clear",
        "category": "Developer",
        "title": "Clear Bee Console",
        "icon": "backspace",
        "runtime": "server"
      },
      {
        "command": "workbench.action.terminal.kill",
        "category": "Terminal",
        "title": "Kill Terminal",
        "icon": "trash",
        "runtime": "server",
        "enablement": "terminalCount > 0"
      },
      {
        "command": "workbench.action.terminal.rename",
        "category": "Terminal",
        "title": "Rename...",
        "runtime": "server",
        "enablement": "terminalCount > 0"
      },
      {
        "command": "workbench.action.terminal.changeIcon",
        "category": "Terminal",
        "title": "Change Icon...",
        "runtime": "server",
        "enablement": "terminalCount > 0"
      },
      {
        "command": "workbench.action.terminal.changeColor",
        "category": "Terminal",
        "title": "Change Color...",
        "runtime": "server",
        "enablement": "terminalCount > 0"
      },
      {
        "command": "workbench.action.openSettingsJson",
        "category": "Preferences",
        "title": "Open User Settings (JSON)",
        "runtime": "server"
      },
      {
        "command": "workbench.action.selectTheme",
        "category": "Preferences",
        "title": "Color Theme",
        "runtime": "server"
      },
      {
        "command": "workbench.action.setColorTheme",
        "category": "Preferences",
        "title": "Set Color Theme",
        "runtime": "server"
      },
      {
        "command": "extension.open",
        "category": "Plugins",
        "title": "Show Plugin Details",
        "runtime": "server"
      },
      {
        "command": "workbench.action.selectIconTheme",
        "category": "Preferences",
        "title": "File Icon Theme",
        "runtime": "server"
      },
      {
        "command": "workbench.action.setIconTheme",
        "category": "Preferences",
        "title": "Set File Icon Theme",
        "runtime": "server"
      },
      {
        "command": "workbench.action.openWorkspaceSettingsFile",
        "category": "Preferences",
        "title": "Open Workspace Settings (JSON)",
        "runtime": "server"
      },
      {
        "command": "workbench.action.openGlobalKeybindingsFile",
        "category": "Preferences",
        "title": "Open Keyboard Shortcuts (JSON)",
        "runtime": "server"
      },
      {
        "command": "bee.plugins.reload",
        "category": "Developer",
        "title": "Reload Plugins",
        "icon": "arrow-path",
        "runtime": "server"
      },
      {
        "command": "explorer.newFile",
        "category": "File",
        "title": "New File…",
        "icon": "document-plus",
        "runtime": "server"
      },
      {
        "command": "explorer.newFolder",
        "category": "File",
        "title": "New Folder…",
        "icon": "folder-plus",
        "runtime": "server"
      },
      {
        "command": "filesExplorer.cut",
        "category": "File",
        "title": "Cut",
        "runtime": "server"
      },
      {
        "command": "filesExplorer.copy",
        "category": "File",
        "title": "Copy",
        "runtime": "server"
      },
      {
        "command": "filesExplorer.paste",
        "category": "File",
        "title": "Paste",
        "runtime": "server",
        "enablement": "explorerCanPaste"
      },
      {
        "command": "renameFile",
        "category": "File",
        "title": "Rename…",
        "runtime": "server"
      },
      {
        "command": "deleteFile",
        "category": "File",
        "title": "Delete",
        "runtime": "server"
      },
      {
        "command": "deleteFile.confirmed",
        "category": "File",
        "title": "Delete (confirmed)",
        "runtime": "server"
      },
      {
        "command": "workbench.extensions.action.installVSIX",
        "category": "Plugins",
        "title": "Install from VSIX…",
        "icon": "arrow-down-tray",
        "runtime": "client"
      },
      {
        "command": "editor.action.insertSnippet",
        "category": "Snippets",
        "title": "Insert Snippet",
        "runtime": "server",
        "enablement": "resourceScheme == file"
      },
      {
        "command": "bee.insertSnippet",
        "category": "Snippets",
        "title": "Insert Snippet (picked)",
        "runtime": "server"
      },
      {
        "command": "workbench.extensions.search",
        "category": "Plugins",
        "title": "Search Open VSX",
        "runtime": "server"
      },
      {
        "command": "workbench.extensions.action.clearExtensionsSearchResults",
        "category": "Plugins",
        "title": "Clear Search Results",
        "icon": "x-mark",
        "runtime": "server"
      },
      {
        "command": "workbench.extensions.installExtension",
        "category": "Plugins",
        "title": "Install",
        "runtime": "server"
      },
      {
        "command": "workbench.extensions.updateExtension",
        "category": "Plugins",
        "title": "Update",
        "runtime": "server"
      },
      {
        "command": "bee.plugins.uninstall",
        "category": "Plugins",
        "title": "Uninstall",
        "icon": "trash",
        "runtime": "server"
      },
      {
        "command": "bee.plugins.uninstallConfirmed",
        "category": "Plugins",
        "title": "Uninstall (confirmed)",
        "runtime": "server"
      },
      {
        "command": "bee.plugins.enable",
        "category": "Plugins",
        "title": "Enable",
        "icon": "play",
        "runtime": "server"
      },
      {
        "command": "bee.plugins.disable",
        "category": "Plugins",
        "title": "Disable",
        "icon": "no-symbol",
        "runtime": "server"
      }
    ],

    "keybindings": [
      {"key": "f1", "command": "workbench.action.showCommands"},
      {"key": "ctrl+shift+p", "mac": "cmd+shift+p", "command": "workbench.action.showCommands"},
      {"key": "ctrl+e", "mac": "cmd+e", "command": "workbench.action.quickOpen"},
      {"key": "ctrl+p", "mac": "cmd+p", "command": "workbench.action.quickOpen"},
      {"key": "ctrl+s", "mac": "cmd+s", "command": "workbench.action.files.save"},
      {"key": "ctrl+k ctrl+o", "mac": "cmd+k cmd+o", "command": "workbench.action.files.openFolder"},
      {"key": "ctrl+z", "mac": "cmd+z", "command": "undo", "when": "editorTextFocus"},
      {"key": "ctrl+shift+z", "mac": "cmd+shift+z", "command": "redo", "when": "editorTextFocus"},
      {"key": "ctrl+space", "command": "editor.action.triggerSuggest", "when": "editorTextFocus"},
      {"key": "ctrl+k ctrl+i", "mac": "cmd+k cmd+i", "command": "editor.action.showHover", "when": "editorTextFocus"},
      {"key": "f12", "command": "editor.action.revealDefinition", "when": "editorTextFocus && editorHasDefinitionProvider"},
      {"key": "ctrl+f12", "mac": "cmd+f12", "command": "editor.action.goToImplementation", "when": "editorTextFocus && editorHasImplementationProvider"},
      {"key": "ctrl+b", "mac": "cmd+b", "command": "workbench.action.toggleSidebarVisibility"},
      {"key": "ctrl+j", "mac": "cmd+j", "command": "workbench.action.togglePanel"},
      {"key": "ctrl+shift+e", "mac": "cmd+shift+e", "command": "workbench.view.explorer"},
      {"key": "ctrl+shift+x", "mac": "cmd+shift+x", "command": "workbench.view.extensions"},
      {"key": "ctrl+shift+f", "mac": "cmd+shift+f", "command": "workbench.action.findInFiles"},
      {"key": "ctrl+shift+h", "mac": "cmd+shift+h", "command": "workbench.action.replaceInFiles"},
      {"key": "alt+c", "mac": "cmd+alt+c", "command": "toggleSearchCaseSensitive", "when": "searchViewletFocus"},
      {"key": "alt+w", "mac": "cmd+alt+w", "command": "toggleSearchWholeWord", "when": "searchViewletFocus"},
      {"key": "alt+r", "mac": "cmd+alt+r", "command": "toggleSearchRegex", "when": "searchViewletFocus"},
      {"key": "ctrl+,", "mac": "cmd+,", "command": "workbench.action.openSettingsJson"},
      {"key": "ctrl+k ctrl+s", "mac": "cmd+k cmd+s", "command": "workbench.action.openGlobalKeybindingsFile"},
      {"key": "ctrl+k ctrl+t", "mac": "cmd+k cmd+t", "command": "workbench.action.selectTheme"}
    ],

    "themes": [
      {"id": "dark", "label": "Bee Dark", "uiTheme": "vs-dark"},
      {"id": "light", "label": "Bee Light", "uiTheme": "vs"}
    ],

    "viewsContainers": {
      "activitybar": [
        {"id": "explorer", "title": "Explorer", "icon": "document-duplicate"},
        {"id": "search", "title": "Search", "icon": "magnifying-glass"},
        {"id": "extensions", "title": "Plugins", "icon": "puzzle-piece"}
      ],
      "panel": [
        {"id": "terminal", "title": "Terminal", "icon": "command-line"},
        {"id": "console", "title": "Bee Console", "icon": "code-bracket"},
        {"id": "output", "title": "Output", "icon": "queue-list"}
      ]
    },

    "views": {
      "explorer": [{"id": "workbench.explorer.fileView", "name": "Folders"}],
      "search": [{"id": "workbench.view.search", "name": "Search"}],
      "extensions": [
        {"id": "workbench.extensions.marketplace", "name": "Open VSX", "when": "searchMarketplaceExtensions"},
        {"id": "workbench.extensions.installed", "name": "Installed", "when": "!searchMarketplaceExtensions"},
        {"id": "workbench.extensions.builtin", "name": "Built-in", "when": "!searchMarketplaceExtensions"}
      ],
      "terminal": [{"id": "workbench.panel.terminal", "name": "Terminal"}],
      "console": [{"id": "workbench.panel.console", "name": "Bee Console"}],
      "output": [{"id": "workbench.panel.output", "name": "Output"}]
    },

    "menubar": [
      {"id": "file", "label": "File"},
      {"id": "edit", "label": "Edit"},
      {"id": "view", "label": "View"},
      {"id": "terminal", "label": "Terminal"}
    ],

    "menus": {
      "menubar/file": [
        {"command": "workbench.action.files.openFolder", "group": "0_open@1"},
        {"command": "workbench.action.files.openFolderInNewWindow", "group": "0_open@2"},
        {"command": "workbench.action.files.save", "group": "1_save@1"},
        {"command": "workbench.action.closeActiveEditor", "group": "1_save@2"},
        {"command": "workbench.action.openSettingsJson", "group": "2_preferences@1"},
        {"command": "workbench.action.openWorkspaceSettingsFile", "group": "2_preferences@2"},
        {"command": "workbench.action.openGlobalKeybindingsFile", "group": "2_preferences@3"},
        {"command": "workbench.action.selectTheme", "group": "2_preferences@4"},
        {"command": "workbench.action.selectIconTheme", "group": "2_preferences@5"}
      ],
      "editor/context": [
        {"command": "editor.action.revealDefinition", "group": "navigation@1", "when": "editorHasDefinitionProvider"},
        {"command": "editor.action.revealDeclaration", "group": "navigation@2", "when": "editorHasDeclarationProvider"},
        {"command": "editor.action.goToTypeDefinition", "group": "navigation@3", "when": "editorHasTypeDefinitionProvider"},
        {"command": "editor.action.goToImplementation", "group": "navigation@4", "when": "editorHasImplementationProvider"},
        {"command": "editor.action.clipboardCutAction", "group": "9_cutcopypaste@1"},
        {"command": "editor.action.clipboardCopyAction", "group": "9_cutcopypaste@2"},
        {"command": "editor.action.clipboardPasteAction", "group": "9_cutcopypaste@3"},
        {"command": "workbench.action.showCommands", "group": "z_commands@1"}
      ],
      "menubar/edit": [
        {"command": "undo", "group": "1_do@1"},
        {"command": "redo", "group": "1_do@2"},
        {"command": "workbench.action.findInFiles", "group": "2_find@1"},
        {"command": "workbench.action.replaceInFiles", "group": "2_find@2"}
      ],
      "view/title": [
        {"command": "workbench.action.terminal.new", "group": "navigation@1", "when": "view == workbench.panel.terminal"},
        {"command": "workbench.action.terminal.kill", "group": "navigation@2", "when": "view == workbench.panel.terminal"},
        {"command": "bee.console.clear", "group": "navigation@1", "when": "view == workbench.panel.console"},
        {"command": "workbench.output.action.clearOutput", "group": "navigation@1", "when": "view == workbench.panel.output"},
        {"command": "search.action.refreshSearchResults", "group": "navigation@1", "when": "view == workbench.view.search"},
        {"command": "search.action.clearSearchResults", "group": "navigation@2", "when": "view == workbench.view.search"},
        {"command": "search.action.collapseSearchResults", "group": "navigation@3", "when": "view == workbench.view.search"},
        {"command": "explorer.newFile", "group": "navigation@1", "when": "view == workbench.explorer.fileView"},
        {"command": "explorer.newFolder", "group": "navigation@2", "when": "view == workbench.explorer.fileView"},
        {"command": "workbench.extensions.action.installVSIX", "group": "navigation@1", "when": "view == workbench.extensions.installed"},
        {"command": "bee.plugins.reload", "group": "navigation@2", "when": "view == workbench.extensions.installed"},
        {"command": "workbench.extensions.action.clearExtensionsSearchResults", "group": "navigation@1", "when": "view == workbench.extensions.marketplace"}
      ],
      "view/item/context": [
        {"command": "bee.plugins.disable", "group": "inline@1", "when": "view =~ /^workbench\\.extensions\\./ && viewItem =~ /^plugin\\.enabled\\./"},
        {"command": "bee.plugins.enable", "group": "inline@1", "when": "view =~ /^workbench\\.extensions\\./ && viewItem =~ /^plugin\\.disabled\\./"},
        {"command": "bee.plugins.uninstall", "group": "inline@2", "when": "view == workbench.extensions.installed && viewItem =~ /\\.user$/"},
        {"command": "workbench.extensions.installExtension", "group": "inline@1", "when": "view == workbench.extensions.marketplace && viewItem == openvsx.notInstalled"},
        {"command": "workbench.extensions.updateExtension", "group": "inline@1", "when": "view == workbench.extensions.marketplace && viewItem == openvsx.outdated"}
      ],
      "panel/title": [
        {"command": "workbench.action.toggleMaximizedPanel", "group": "navigation@1"},
        {"command": "workbench.action.closePanel", "group": "navigation@2"}
      ],
      "terminal/title/context": [
        {"command": "workbench.action.terminal.rename", "group": "1_edit@1"},
        {"command": "workbench.action.terminal.changeIcon", "group": "1_edit@2"},
        {"command": "workbench.action.terminal.changeColor", "group": "1_edit@3"},
        {"command": "workbench.action.terminal.kill", "group": "2_kill@1"}
      ],
      "editor/title/context": [
        {"command": "workbench.action.closeEditor", "group": "1_close@1"},
        {"command": "workbench.action.closeOtherEditors", "group": "1_close@2"},
        {"command": "workbench.action.closeAllEditors", "group": "1_close@3"},
        {"command": "copyFilePath", "group": "2_copy@1", "when": "resourceScheme == file"}
      ],
      "explorer/context": [
        {"command": "explorer.newFile", "group": "navigation@1", "when": "explorerResourceIsFolder"},
        {"command": "explorer.newFolder", "group": "navigation@2", "when": "explorerResourceIsFolder"},
        {"command": "filesExplorer.cut", "group": "5_cutcopypaste@1", "when": "!explorerResourceIsRoot"},
        {"command": "filesExplorer.copy", "group": "5_cutcopypaste@2", "when": "!explorerResourceIsRoot"},
        {"command": "filesExplorer.paste", "group": "5_cutcopypaste@3"},
        {"command": "renameFile", "group": "7_modification@1", "when": "!explorerResourceIsRoot"},
        {"command": "deleteFile", "group": "7_modification@2", "when": "!explorerResourceIsRoot"}
      ],
      "commandPalette": [
        {"command": "editor.action.clipboardCutAction", "when": "false"},
        {"command": "editor.action.clipboardCopyAction", "when": "false"},
        {"command": "editor.action.clipboardPasteAction", "when": "false"},
