{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "bee://schemas/manifest.schema.json",
  "title": "Bee manifest",
  "description": "What a source contributes to Bee: Bee's own manifests (priv/contributions/*.json) and plugins (<plugin>/plugin.json). Modelled on a VS Code extension's package.json.",
  "type": "object",
  "required": ["name", "contributes"],
  "properties": {
    "$schema": {"type": "string"},
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Unique id: lowercase letters, digits and dashes."
    },
    "displayName": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "version": {"type": "string", "minLength": 1},
    "server": {
      "type": "object",
      "description": "Code that runs in Bee's BEAM: Elixir (.ex) and/or Erlang (.erl) files. One module implements the Bee.Plugin behaviour.",
      "required": ["module"],
      "additionalProperties": false,
      "properties": {
        "module": {
          "type": "string",
          "minLength": 1,
          "description": "The Bee.Plugin module: an Elixir name (\"WordCount\") or an Erlang one (\"bee_upcase\")."
        },
        "sources": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "default": ["lib", "src"],
          "description": "Files or directories (relative to the plugin) to compile."
        }
      }
    },
    "browser": {
      "type": "string",
      "pattern": "\\.m?js$",
      "description": "ES module (relative to the plugin) loaded in the browser. It exports activate(bee)."
    },
    "activationEvents": {
      "type": "array",
      "description": "When the server part starts. Running one of the plugin's commands, or showing one of its views, always starts it.",
      "items": {"type": "string", "pattern": "^(\\*|onStartupFinished|onLanguage:[A-Za-z0-9_.+-]+|onView:[A-Za-z0-9_.-]+)$"}
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commands": {"type": "array", "items": {"$ref": "#/definitions/command"}},
        "keybindings": {"type": "array", "items": {"$ref": "#/definitions/keybinding"}},
        "menubar": {"type": "array", "items": {"$ref": "#/definitions/menubarEntry"}},
        "menus": {
          "type": "object",
          "description": "Menu id to items: \"menubar/<id>\", \"editor/title\" (editor buttons), \"view/title\" (view header buttons; `when` can test `view`), \"view/item/context\" (group \"inline\": buttons on a view's items; `when` can test `view` and `viewItem`), \"commandPalette\" (`when` false hides a command from the palette).",
          "additionalProperties": {"type": "array", "items": {"$ref": "#/definitions/menuItem"}}
        },
        "languages": {"type": "array", "items": {"$ref": "#/definitions/language"}},
        "grammars": {"type": "array", "items": {"$ref": "#/definitions/grammar"}},
        "configuration": {"$ref": "#/definitions/configuration"},
        "viewsContainers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "activitybar": {"type": "array", "items": {"$ref": "#/definitions/viewsContainer"}}
          }
        },
        "views": {
          "type": "object",
          "description": "Views container id (yours, or e.g. \"explorer\") to the views shown in it.",
          "additionalProperties": {"type": "array", "items": {"$ref": "#/definitions/view"}}
        }
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "whenClause": {"type": "string", "description": "VS Code style `when` clause."},
    "command": {
      "type": "object",
      "required": ["command", "title", "runtime"],
      "additionalProperties": false,
      "properties": {
        "command": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
        "title": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "icon": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "Icon shown where the command is a button (editor/title, view/title, view/item/context menus): a Heroicons outline name, e.g. \"arrow-path\"."
        },
        "runtime": {
          "enum": ["server", "client"],
          "description": "server: a handler in the BEAM (`@command` function of Bee or of the plugin's server module); client: a handler registered in the browser."
        },
        "enablement": {"$ref": "#/definitions/whenClause"},
        "toggled": {"$ref": "#/definitions/whenClause"}
      }
    },
    "keybinding": {
      "type": "object",
      "required": ["key", "command"],
      "additionalProperties": false,
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "mac": {"type": "string", "minLength": 1},
        "command": {"type": "string", "minLength": 1},
        "when": {"$ref": "#/definitions/whenClause"}
      }
    },
    "menubarEntry": {
      "type": "object",
      "required": ["id", "label"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
        "label": {"type": "string", "minLength": 1}
      }
    },
    "menuItem": {
      "type": "object",
      "required": ["command"],
      "additionalProperties": false,
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "group": {
          "type": "string",
          "pattern": "^[^@]+(@[0-9]+)?$",
          "description": "\"<group>@<order>\". Groups sort by name and are separated by a line; items sort by order."
        },
        "when": {"$ref": "#/definitions/whenClause"}
      }
    },
    "viewsContainer": {
      "type": "object",
      "required": ["id", "title", "icon"],
      "additionalProperties": false,
      "description": "An icon in the activity bar that shows a set of views in the sidebar.",
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
        "title": {"type": "string", "minLength": 1},
        "icon": {"type": "string", "pattern": "^[a-z0-9-]+$", "description": "A Heroicons outline name."}
      }
    },
    "view": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "description": "A sidebar view. A plugin fills its views with Bee.API.set_view/3.",
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
        "name": {"type": "string", "minLength": 1},
        "when": {"$ref": "#/definitions/whenClause"}
      }
    },
    "language": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "description": "A language, or more files for an existing one (contributions with the same id merge).",
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "aliases": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "description": "Display names; the first one is shown in the status bar."
        },
        "extensions": {"type": "array", "items": {"type": "string", "pattern": "^\\."}},
        "filenames": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "filenamePatterns": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "description": "Globs matched against the file name, or the workspace-relative path when they contain a slash."
        },
        "firstLine": {"type": "string", "minLength": 1, "description": "Regex matched against the first line."}
      }
    },
    "grammar": {
      "type": "object",
      "required": ["language", "mode"],
      "additionalProperties": false,
      "description": "Highlighting for a language: the name of a CodeMirror mode registered in the browser (bundled with Bee, or registerMode() of a browser plugin).",
      "properties": {
        "language": {"type": "string", "minLength": 1},
        "mode": {"type": "string", "minLength": 1}
      }
    },
    "configuration": {
      "type": "object",
      "required": ["properties"],
      "additionalProperties": false,
      "description": "Settings: each property is a JSON Schema (draft 7) for one setting, with a default and a description.",
      "properties": {
        "title": {"type": "string"},
        "properties": {
          "type": "object",
          "propertyNames": {"pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)+$"},
          "additionalProperties": {"type": "object"}
        }
      }
    }
  }
}
