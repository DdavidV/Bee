{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "bee://schemas/contributions.schema.json",
  "title": "Bee contributions manifest",
  "description": "Commands, keybindings and menus contributed by Bee itself (priv/contributions/bee.json) or a plugin. Modelled on the `contributes` section of a VS Code extension's package.json.",
  "type": "object",
  "required": ["name", "contributes"],
  "properties": {
    "$schema": {"type": "string"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commands": {"type": "array", "items": {"$ref": "#/definitions/command"}},
        "keybindings": {"type": "array", "items": {"$ref": "#/definitions/keybinding"}},
        "menubar": {"type": "array", "items": {"$ref": "#/definitions/menubarEntry"}},
        "menus": {
          "type": "object",
          "description": "Menu id (e.g. \"menubar/file\") to items.",
          "additionalProperties": {"type": "array", "items": {"$ref": "#/definitions/menuItem"}}
        }
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "whenClause": {"type": "string", "description": "VS Code style `when` clause."},
    "command": {
      "type": "object",
      "required": ["command", "title", "runtime"],
      "additionalProperties": false,
      "properties": {
        "command": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
        "title": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "runtime": {
          "enum": ["server", "client"],
          "description": "server: a `use Bee.Commands.Command` function; client: a handler registered in the browser (assets/js/commands/registry.js)."
        },
        "enablement": {"$ref": "#/definitions/whenClause"},
        "toggled": {"$ref": "#/definitions/whenClause"}
      }
    },
    "keybinding": {
      "type": "object",
      "required": ["key", "command"],
      "additionalProperties": false,
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "mac": {"type": "string", "minLength": 1},
        "command": {"type": "string", "minLength": 1},
        "when": {"$ref": "#/definitions/whenClause"}
      }
    },
    "menubarEntry": {
      "type": "object",
      "required": ["id", "label"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
        "label": {"type": "string", "minLength": 1}
      }
    },
    "menuItem": {
      "type": "object",
      "required": ["command"],
      "additionalProperties": false,
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "group": {
          "type": "string",
          "pattern": "^[^@]+(@[0-9]+)?$",
          "description": "\"<group>@<order>\". Groups sort by name and are separated by a line; items sort by order."
        },
        "when": {"$ref": "#/definitions/whenClause"}
      }
    }
  }
}
