<%!-- The color theme's colors, when it has its own (Bee.ColorThemes.Theme.css/2):
     CSS variables on #workbench, over its daisyUI theme (data-theme, its base).
     <%= %>: HEEx doesn't interpolate {…} in a style element. --%>
<style :if={@color_theme_css != ""} id="color-theme">
  <%= @color_theme_css %>
</style>
<%!-- The Keybindings hook reads data-keybindings and data-context (the server
     part of the `when` context; focus keys are added in the browser). --%>
<div
  id="workbench"
  phx-hook="Keybindings"
  data-theme={@color_theme.base}
  data-color-theme={@color_theme.id}
  data-keybindings={Jason.encode!(@client_keybindings)}
  data-context={Jason.encode!(context(assigns))}
  data-root={@root}
  style={layout_style(assigns, @connected)}
  class={[
    "h-screen w-screen grid grid-rows-[auto_1fr_auto] bg-base-100 text-base-content overflow-hidden",
    if(@sidebar_open,
      do: "grid-cols-[3rem_var(--drag-sidebar-width,var(--sidebar-width))_1fr]",
      else: "grid-cols-[3rem_1fr]"
    )
  ]}
>
  <BeeWeb.Workbench.TitleBar.title_bar
    title={
      window_title(
        @active && tab_label(Workbench.tab(workbench_from(assigns), @active), @extension_details),
        @root
      )
    }
    palette={@palette}
    palette_items={palette_items(assigns)}
    palette_shortcut={Bee.Commands.Keybindings.label("workbench.action.quickOpen", @keybindings)}
    icon_theme={@icon_theme}
    palette_busy={quick_open_busy?(assigns)}
    menus={menubar(assigns)}
    open_menu={@open_menu}
    sidebar_open={@sidebar_open}
    panel_open={@panel_open}
  />

  <%!-- Activity bar and sidebar: views containers and views (Bee.Views) --%>
  <BeeWeb.Workbench.Sidebar.activity_bar
    containers={activity_bar(assigns)}
    sidebar_view={@sidebar_view}
    sidebar_open={@sidebar_open}
    keybindings={@keybindings}
  />

  <BeeWeb.Workbench.Sidebar.sidebar
    container={Enum.find(@containers, &(&1.id == @sidebar_view))}
    views={sidebar_views(assigns)}
    sidebar_open={@sidebar_open}
    root={@root}
    active={Workbench.active_file(workbench_from(assigns))}
    plugins={@plugins}
    view_contents={@view_contents}
    view_inputs={@view_inputs}
    collapsed={@collapsed}
    collapsed_views={@collapsed_views}
    view_sizes={@view_sizes}
    search={@search}
    file_decorations={@file_decorations}
    icon_theme={@icon_theme}
    clipboard={@clipboard}
    marketplace={@marketplace}
    marketplace_installed={@marketplace_installed}
    socket={@socket}
    live={@live}
  />

  <%!-- Editor area --%>
  <main class="relative min-w-0 min-h-0 flex flex-col">
    <%!-- Sash between sidebar and editors: drag to resize, double-click to reset --%>
    <div
      :if={@sidebar_open}
      id="sash-sidebar"
      phx-hook="Sash"
      data-part="sidebar"
      class="sash absolute inset-y-0 left-0 w-1 -translate-x-1/2 z-30 cursor-col-resize"
    >
    </div>
    <div class="flex bg-tabs shrink-0">
      <%!-- Tabs: dragged to reorder, middle-clicked to close (the Tabs hook);
           right-clicked for the editor/title/context menu. --%>
      <div id="tabs" phx-hook="Tabs" class="flex flex-1 min-w-0 overflow-x-auto text-sm">
        <div
          :for={tab <- @tabs}
          id={"tab-#{:erlang.phash2(tab.path)}"}
          data-tab
          data-path={tab.path}
          data-active={to_string(tab.path == @active)}
          data-dirty={tab.dirty && "true"}
          data-menu="editor/title/context"
          data-menu-args={Jason.encode!([tab.path])}
          data-menu-context={Jason.encode!(tab_menu_context(tab))}
          class={[
            "group flex items-center gap-1 pl-3 pr-1 py-1.5 border-r border-tab-border cursor-pointer whitespace-nowrap",
            if(tab.path == @active,
              do: "bg-tab-active text-tab-active-fg",
              else:
                "bg-tab-inactive text-tab-inactive-fg hover:text-tab-active-fg hover:bg-base-content/5"
            )
          ]}
          phx-click="activate_tab"
          phx-value-path={tab.path}
          title={
            if tab.kind == :file,
              do: Bee.Workspace.FS.relative(@root, tab.path),
              else: tab_label(tab, @extension_details)
          }
        >
          <BeeWeb.Workbench.FileIcon.file_icon
            :if={@icon_theme && tab.kind == :file}
            theme={@icon_theme}
            path={tab.path}
            language={tab.lang}
          />
          <.icon
            :if={tab.kind == :extension}
            name="hero-puzzle-piece"
            class="size-4 shrink-0 opacity-70"
          />
          <.icon
            :if={tab.kind in [:live, :webview]}
            name="hero-window"
            class="size-4 shrink-0 opacity-70"
          />
          <span class={[
            tab.kind == :file && tab_color(@file_decorations, @root, tab.path),
            tab.kind == :extension && "italic"
          ]}>
            {tab_label(tab, @extension_details)}
          </span>
          <button
            class="size-5 grid place-items-center rounded cursor-pointer hover:bg-base-content/10"
            title="Close"
            data-close
            phx-click="run_command"
            phx-value-command="workbench.action.closeEditor"
            phx-value-args={Jason.encode!([tab.path])}
          >
            <span :if={tab.dirty} class="size-2 rounded-full bg-current group-hover:hidden" />
            <.icon
              name="hero-x-mark-mini"
              class={["size-4", tab.dirty && "hidden group-hover:block"]}
            />
          </button>
        </div>
      </div>
      <%!-- Editor actions: the "editor/title" menu (undo/redo, plugins' buttons) --%>
      <BeeWeb.Workbench.Toolbar.toolbar
        id="editor-actions"
        actions={toolbar(assigns, "editor/title")}
        class="px-1"
      />
    </div>

    <%!-- Right-clicking a file's text: the editor/context menu. --%>
    <div
      id="editor-area"
      class="flex-1 min-h-0 relative"
      data-menu={editor_menu(assigns) && "editor/context"}
      data-menu-args={Jason.encode!(List.wrap(editor_menu(assigns)))}
    >
      <div
        id="editor"
        phx-hook="CodeEditor"
        phx-update="ignore"
        data-settings={Jason.encode!(@editor_settings)}
        data-grammars={Jason.encode!(@grammars)}
        data-root={@root}
        data-token-colors={Jason.encode!(@token_colors)}
        class="absolute inset-0"
      >
      </div>
      <%!-- A plugin's details, over the (emptied) editor --%>
      <div
        :for={tab <- @tabs}
        :if={tab.kind == :extension and tab.path == @active}
        class="absolute inset-0"
      >
        <BeeWeb.Workbench.ExtensionEditor.extension_editor
          name={tab.name}
          details={@extension_details[tab.name]}
          installed={@marketplace_installed}
          installing={@marketplace.installing}
        />
      </div>
      <%!-- Editors plugins draw themselves (LiveViews): each stays mounted
           while its tab is open, shown when it is the active one. --%>
      <div
        :for={tab <- @tabs}
        :if={tab.kind == :live}
        id={"live-editor-#{:erlang.phash2(tab.path)}"}
        data-live-editor={tab.editor}
        class={[
          "absolute inset-0 overflow-auto bg-editor text-editor-fg",
          tab.path != @active && "hidden"
        ]}
      >
        <BeeWeb.Workbench.PluginLive.plugin_live
          socket={@socket}
          state={@live[{:editor, tab.editor}]}
          kind="editor"
          id={tab.editor}
          key={tab.key}
          root={@root}
          params={tab.params}
        />
      </div>
      <%!-- Webview panels of extensions: each frame stays while its tab is open. --%>
      <BeeWeb.Workbench.Webview.webview
        :for={tab <- @tabs}
        :if={tab.kind == :webview and @webviews[tab.webview]}
        panel={@webviews[tab.webview]}
        theme={@color_theme.id}
        active={tab.path == @active}
        origin={@webview_origin}
      />
      <div
        :if={@tabs == []}
        class="absolute inset-0 grid place-items-center bg-editor text-editor-fg text-sm"
      >
        <div class="text-center space-y-1 opacity-40">
          <BeeWeb.Logo.logo class="size-12 mx-auto mb-2" />
          <div>Open a file from the explorer</div>
          <div :for={
            {label, command} <- [
              {"Show All Commands", "workbench.action.showCommands"},
              {"Go to File", "workbench.action.quickOpen"},
              {"Toggle Terminal", "workbench.action.togglePanel"},
              {"Open Settings", "workbench.action.openSettingsJson"}
            ]
          }>
            {label}
            <kbd
              :if={key = Bee.Commands.Keybindings.label(command, @keybindings)}
              class="kbd kbd-xs ml-1"
            >
              {key}
            </kbd>
          </div>
        </div>
      </div>
    </div>

    <%!-- The bottom panel: Terminal, Bee Console, plugins' sections --%>
    <BeeWeb.Workbench.Panel.panel
      :if={@panel_open}
      maximized={@panel_maximized}
      active={@panel_view}
      sections={panel_sections(assigns)}
      actions={panel_actions(assigns)}
      terminals={@terminals}
      active_term={@active_term}
      console={@console}
      terminal_settings={@terminal_settings}
      view_contents={@view_contents}
      view_inputs={@view_inputs}
      collapsed={@collapsed}
      icon_theme={@icon_theme}
      socket={@socket}
      live={@live}
      root={@root}
      output_channels={@output_channels}
      output_channel={@output_channel}
      references={@references}
      problems={problem_entries(assigns)}
      problems_hidden={@problems_hidden}
    />
  </main>

  <%!-- Status bar --%>
  <footer class="col-span-full h-6 bg-statusbar text-statusbar-fg text-xs flex items-center gap-4 px-3">
    <span class="truncate">{@root}</span>
    <.status_item :for={item <- @status_items} :if={item.alignment == :left} item={item} />
    <button
      :if={(problems = problems(assigns)) != []}
      id="problems"
      class="flex items-center gap-1 cursor-pointer hover:underline"
      title={
        problems
        |> Enum.take(25)
        |> Enum.map_join("\n", &"#{Path.basename(&1.path)}: #{&1.message}")
      }
      phx-click="run_command"
      phx-value-command="workbench.actions.view.problems"
    >
      <.icon name="hero-exclamation-triangle-micro" class="size-3.5" />
      {length(problems)} {if length(problems) == 1, do: "problem", else: "problems"}
    </button>
    <div class="flex-1" />
    <.status_item :for={item <- @status_items} :if={item.alignment == :right} item={item} />
    <%!-- Filled in by the Keybindings hook while a chord is pending --%>
    <span id="keybinding-status" phx-update="ignore"></span>
    <span :if={@status} id="status" class="truncate">{@status}</span>
    <span
      :if={lang = @active && Workbench.language(%Workbench{tabs: @tabs}, @active)}
      id="status-lang"
    >
      {Bee.Languages.name(lang)}
    </span>
  </footer>

  <%!-- Right-click menus (ContextMenus hook opens them) --%>
  <div id="context-menus" phx-hook="ContextMenus" class="hidden"></div>
  <BeeWeb.Workbench.ContextMenu.context_menu
    :if={@context_menu}
    menu={@context_menu}
    items={context_menu_items(assigns)}
  />

  <%!-- The file picker of Plugins: Install from VSIX… (VsixInstall hook) --%>
  <form id="vsix-form" phx-hook="VsixInstall" phx-change="vsix_validate" class="hidden">
    <.live_file_input upload={@uploads.vsix} accept=".vsix" />
  </form>

  <%!-- Browser parts of plugins, loaded by the Plugins hook --%>
  <%!-- Plugins' stylesheets, for their LiveViews --%>
  <link
    :for={style <- @plugin_styles}
    rel="stylesheet"
    href={style.url}
    data-plugin-style={style.name}
  />
  <div
    id="browser-plugins"
    phx-hook="Plugins"
    phx-update="ignore"
    data-plugins={Jason.encode!(@browser_plugins)}
    class="hidden"
  >
  </div>

  <Layouts.flash_group flash={@flash} />
</div>
