<div
  id="workbench"
  class="h-screen w-screen grid grid-rows-[1fr_auto] grid-cols-[3rem_16rem_1fr] bg-base-100 text-base-content overflow-hidden"
>
  <%!-- Activity bar --%>
  <aside class="bg-base-300 flex flex-col items-center gap-1 py-2">
    <button class="btn btn-ghost btn-square btn-sm" title="Explorer">
      <.icon name="hero-document-duplicate" class="size-5" />
    </button>
  </aside>

  <%!-- Sidebar --%>
  <aside class="bg-base-200 overflow-auto border-r border-base-300">
    <.live_component
      module={BeeWeb.FileTreeComponent}
      id="explorer"
      root={@root}
      active={@selected}
    />
  </aside>

  <%!-- Editor area --%>
  <main class="min-w-0 min-h-0 grid place-items-center text-sm opacity-40">
    <div class="text-center space-y-1">
      <div class="text-4xl">🐝</div>
      <div :if={!@selected}>Select a file in the explorer</div>
      <div :if={@selected} id="selected-file">{@selected}</div>
    </div>
  </main>

  <%!-- Status bar --%>
  <footer class="col-span-3 h-6 bg-primary text-primary-content text-xs flex items-center gap-4 px-3">
    <span class="truncate">{@root}</span>
  </footer>

  <Layouts.flash_group flash={@flash} />
</div>
