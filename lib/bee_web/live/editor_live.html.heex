<%!-- The Keybindings hook reads data-keybindings and data-context (the server
     part of the `when` context; focus keys are added in the browser). --%>
<div
  id="workbench"
  phx-hook="Keybindings"
  data-theme={@settings["workbench.colorTheme"]}
  data-keybindings={Jason.encode!(@client_keybindings)}
  data-context={Jason.encode!(context(assigns))}
  data-root={@root}
  style={layout_style(assigns, @connected)}
  class={[
    "h-screen w-screen grid grid-rows-[auto_1fr_auto] bg-base-100 text-base-content overflow-hidden",
    if(@sidebar_open,
      do: "grid-cols-[3rem_var(--drag-sidebar-width,var(--sidebar-width))_1fr]",
      else: "grid-cols-[3rem_1fr]"
    )
  ]}
>
  <BeeWeb.Workbench.TitleBar.title_bar
    title={window_title(@active, @root)}
    palette={@palette}
    palette_items={palette_items(assigns)}
    palette_shortcut={
      Bee.Commands.Keybindings.label("workbench.action.showCommands", @keybindings)
    }
    menus={menubar(assigns)}
    open_menu={@open_menu}
    sidebar_open={@sidebar_open}
    panel_open={@panel_open}
  />

  <%!-- Activity bar and sidebar: views containers and views (Bee.Views) --%>
  <BeeWeb.Workbench.Sidebar.activity_bar
    containers={activity_bar(assigns)}
    sidebar_view={@sidebar_view}
    sidebar_open={@sidebar_open}
    keybindings={@keybindings}
  />

  <BeeWeb.Workbench.Sidebar.sidebar
    container={Enum.find(@containers, &(&1.id == @sidebar_view))}
    views={sidebar_views(assigns)}
    sidebar_open={@sidebar_open}
    root={@root}
    active={@active}
    plugins={@plugins}
    view_contents={@view_contents}
    view_inputs={@view_inputs}
    collapsed={@collapsed}
    collapsed_views={@collapsed_views}
    view_sizes={@view_sizes}
    search={@search}
    file_decorations={@file_decorations}
  />

  <%!-- Editor area --%>
  <main class="relative min-w-0 min-h-0 flex flex-col">
    <%!-- Sash between sidebar and editors: drag to resize, double-click to reset --%>
    <div
      :if={@sidebar_open}
      id="sash-sidebar"
      phx-hook="Sash"
      data-part="sidebar"
      class="sash absolute inset-y-0 left-0 w-1 -translate-x-1/2 z-30 cursor-col-resize"
    >
    </div>
    <div class="flex bg-base-200 shrink-0">
      <div id="tabs" class="flex flex-1 min-w-0 overflow-x-auto text-sm">
        <div
          :for={tab <- @tabs}
          id={"tab-#{:erlang.phash2(tab.path)}"}
          class={[
            "group flex items-center gap-1 pl-3 pr-1 py-1.5 border-r border-base-300 cursor-pointer whitespace-nowrap",
            if(tab.path == @active,
              do: "bg-base-100",
              else: "opacity-70 hover:opacity-100 hover:bg-base-content/5"
            )
          ]}
          phx-click="activate_tab"
          phx-value-path={tab.path}
          title={Bee.Workspace.FS.relative(@root, tab.path)}
        >
          <span class={tab_color(@file_decorations, @root, tab.path)}>
            {Path.basename(tab.path)}
          </span>
          <button
            class="size-5 grid place-items-center rounded cursor-pointer hover:bg-base-content/10"
            title="Close"
            phx-click="close_tab"
            phx-value-path={tab.path}
            data-confirm={tab.dirty && "Discard unsaved changes to #{Path.basename(tab.path)}?"}
          >
            <span :if={tab.dirty} class="size-2 rounded-full bg-base-content group-hover:hidden" />
            <.icon
              name="hero-x-mark-mini"
              class={["size-4", tab.dirty && "hidden group-hover:block"]}
            />
          </button>
        </div>
      </div>
      <%!-- Editor actions: the "editor/title" menu (undo/redo, plugins' buttons) --%>
      <BeeWeb.Workbench.Toolbar.toolbar
        id="editor-actions"
        actions={toolbar(assigns, "editor/title")}
        class="px-1"
      />
    </div>

    <div class="flex-1 min-h-0 relative">
      <div
        id="editor"
        phx-hook="CodeEditor"
        phx-update="ignore"
        data-settings={Jason.encode!(@editor_settings)}
        class="absolute inset-0"
      >
      </div>
      <div
        :if={@tabs == []}
        class="absolute inset-0 grid place-items-center bg-base-100 text-sm"
      >
        <div class="text-center space-y-1 opacity-40">
          <div class="text-4xl">🐝</div>
          <div>Open a file from the explorer</div>
          <div :for={
            {label, command} <- [
              {"Show All Commands", "workbench.action.showCommands"},
              {"Toggle Terminal", "workbench.action.togglePanel"},
              {"Open Settings", "workbench.action.openSettingsJson"}
            ]
          }>
            {label}
            <kbd
              :if={key = Bee.Commands.Keybindings.label(command, @keybindings)}
              class="kbd kbd-xs ml-1"
            >
              {key}
            </kbd>
          </div>
        </div>
      </div>
    </div>

    <%!-- Panel: terminals --%>
    <section
      :if={@panel_open}
      id="panel"
      class="relative h-[var(--drag-panel-height,var(--panel-height))] max-h-[calc(100%-4rem)] shrink-0 overflow-hidden border-t border-base-300 flex flex-col bg-base-100"
    >
      <div
        id="sash-panel"
        phx-hook="Sash"
        data-part="panel"
        class="sash absolute inset-x-0 top-0 h-1 z-30 cursor-row-resize"
      >
      </div>
      <div class="flex items-center gap-1 px-2 text-xs shrink-0">
        <span class="uppercase tracking-wide opacity-60 mr-2">Terminal</span>
        <button
          :for={{term, i} <- Enum.with_index(@terminals, 1)}
          id={"term-tab-#{term.id}"}
          class={[
            "px-2 py-1 rounded cursor-pointer",
            if(term.id == @active_term,
              do: "bg-base-300",
              else: "opacity-70 hover:bg-base-content/10"
            )
          ]}
          phx-click="activate_terminal"
          phx-value-id={term.id}
        >
          {i}: {term.name}
        </button>
        <div class="flex-1" />
        <button
          class="btn btn-ghost btn-xs btn-square"
          title="New Terminal"
          phx-click="run_command"
          phx-value-command="workbench.action.terminal.new"
        >
          <.icon name="hero-plus" class="size-4" />
        </button>
        <button
          :if={@active_term}
          class="btn btn-ghost btn-xs btn-square"
          title="Kill Terminal"
          phx-click="close_terminal"
          phx-value-id={@active_term}
        >
          <.icon name="hero-trash" class="size-4" />
        </button>
        <button
          class="btn btn-ghost btn-xs btn-square"
          title="Close Panel"
          phx-click="run_command"
          phx-value-command="workbench.action.togglePanel"
        >
          <.icon name="hero-x-mark" class="size-4" />
        </button>
      </div>
      <div class="flex-1 min-h-0 relative">
        <div
          :for={term <- @terminals}
          id={"term-#{term.id}"}
          phx-hook="Terminal"
          phx-update="ignore"
          data-id={term.id}
          data-active={to_string(term.id == @active_term)}
          data-settings={Jason.encode!(@terminal_settings)}
          class="absolute inset-0 pl-2 pt-1 data-[active=false]:invisible"
        >
        </div>
      </div>
    </section>
  </main>

  <%!-- Status bar --%>
  <footer class="col-span-full h-6 bg-primary text-primary-content text-xs flex items-center gap-4 px-3">
    <span class="truncate">{@root}</span>
    <.status_item :for={item <- @status_items} :if={item.alignment == :left} item={item} />
    <button
      :if={(problems = problems(assigns)) != []}
      id="problems"
      class="flex items-center gap-1 cursor-pointer hover:underline"
      title={Enum.map_join(problems, "\n", &"#{Path.basename(&1.path)}: #{&1.message}")}
      phx-click="open_problem"
      phx-value-path={hd(problems).path}
    >
      <.icon name="hero-exclamation-triangle-micro" class="size-3.5" />
      {length(problems)} {if length(problems) == 1, do: "problem", else: "problems"}
    </button>
    <div class="flex-1" />
    <.status_item :for={item <- @status_items} :if={item.alignment == :right} item={item} />
    <%!-- Filled in by the Keybindings hook while a chord is pending --%>
    <span id="keybinding-status" phx-update="ignore"></span>
    <span :if={@status} id="status" class="truncate">{@status}</span>
    <span
      :if={lang = @active && Bee.Workbench.language(%Bee.Workbench{tabs: @tabs}, @active)}
      id="status-lang"
    >
      {Bee.Languages.name(lang)}
    </span>
  </footer>

  <%!-- Browser parts of plugins, loaded by the Plugins hook --%>
  <div
    id="browser-plugins"
    phx-hook="Plugins"
    phx-update="ignore"
    data-plugins={Jason.encode!(@browser_plugins)}
    class="hidden"
  >
  </div>

  <Layouts.flash_group flash={@flash} />
</div>
